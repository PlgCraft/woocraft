{
  "name": "woocraft",
  "version": "0.1.0",
  "description": "Build tooling for WooCommerce extensions: scaffold a PSR-4 plugin with a Vite + Tailwind admin UI, then lint / stan / build / package it, phpcs & phpstan config owned by the CLI.",
  "type": "module",
  "bin": {
    "woocraft": "dist/index.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "template",
    "assets",
    "COMMANDS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlgCraft/woocraft.git"
  },
  "bugs": {
    "url": "https://github.com/PlgCraft/woocraft/issues"
  },
  "homepage": "https://github.com/PlgCraft/woocraft#readme",
  "keywords": [
    "woocommerce",
    "wordpress",
    "plugin",
    "extension",
    "scaffold",
    "generator",
    "boilerplate",
    "vite",
    "tailwind",
    "phpcs",
    "phpstan"
  ],
  "license": "MIT",
  "author": "PlgCraft",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.20.1",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
