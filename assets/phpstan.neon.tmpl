# Generated by woocraft. Do not edit — regenerated on every `woocraft stan`.
# Commit a phpstan.neon.dist at the project root to take full control,
# or a phpstan-baseline.neon (it is included automatically when present).

includes:
	- {{wpExtension}}
{{baselineInclude}}
parameters:
	level: {{level}}
	tmpDir: {{cache}}/phpstan-tmp

	paths:
		- {{root}}/src
		- {{root}}/{{slug}}.php
		- {{root}}/uninstall.php

	bootstrapFiles:
		- {{wcStubs}}
		- {{cache}}/stubs.php

	dynamicConstantNames:
		- {{constant}}_VERSION
		- {{constant}}_FILE
		- {{constant}}_PATH
		- {{constant}}_URL

	treatPhpDocTypesAsCertain: false
