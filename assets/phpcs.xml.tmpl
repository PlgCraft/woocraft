<?xml version="1.0"?>
<ruleset name="{{slug}} (woocraft)">
	<description>
		Generated by woocraft. Do not edit — regenerated on every `woocraft lint`.
		Commit a phpcs.xml.dist at the project root to take full control instead.

		A bug-and-safety ruleset, not a formatting one: the substance the
		WooCommerce Marketplace QIT "Security" and "Code Compatibility"
		tests check — SQL safety, output escaping, nonce use, deprecated
		APIs, PHP cross-version issues.
	</description>

	<file>{{root}}/{{slug}}.php</file>
	<file>{{root}}/uninstall.php</file>
	<file>{{root}}/src</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/src/Admin/dist/*</exclude-pattern>
	<exclude-pattern>{{root}}/src/Admin/*.ts</exclude-pattern>
	<exclude-pattern>{{root}}/src/Admin/*.tsx</exclude-pattern>

	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="{{root}}"/>
	<arg name="parallel" value="8"/>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="{{requiresPHP}}-"/>
	<config name="minimum_supported_wp_version" value="{{requiresWP}}"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP"/>
	<rule ref="WordPress.PHP">
		<exclude name="WordPress.PHP.POSIXFunctions"/>
	</rule>
	<rule ref="WordPress.CodeAnalysis"/>
	<rule ref="Generic.CodeAnalysis.EmptyStatement"/>
	<rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>
	<rule ref="Squiz.PHP.NonExecutableCode"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="{{optionPrefix}}"/>
				<element value="{{constant}}"/>
				<element value="{{namespace}}"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="{{textDomain}}"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
